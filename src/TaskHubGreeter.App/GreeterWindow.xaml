<Window x:Class="TaskHubGreeter.App.GreeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskHubGreeter.App"
        Title="TaskHub Greeter"
        Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
  <Window.Resources>
    <local:VisibleWhenConverter x:Key="Vis" />
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Greeter.ChipBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0,6,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Margin" Value="4,10,0,4" />
    </Style>

    <!-- Pill-shaped filter chip -->
    <Style x:Key="FilterChipButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" CornerRadius="12" Padding="10,3" Background="{DynamicResource Greeter.ChipBrush}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Greeter.AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Margin="18" CornerRadius="12" BorderThickness="1" Padding="22,18,22,12"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Direction="270" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />  <!-- 0 greeting -->
        <RowDefinition Height="Auto" />  <!-- 1 quote -->
        <RowDefinition Height="Auto" />  <!-- 2 summary -->
        <RowDefinition Height="Auto" />  <!-- 3 plan / wrap up -->
        <RowDefinition Height="Auto" />  <!-- 4 offline -->
        <RowDefinition Height="Auto" />  <!-- 5 search -->
        <RowDefinition Height="Auto" />  <!-- 6 chips -->
        <RowDefinition Height="Auto" />  <!-- 7 meetings -->
        <RowDefinition Height="Auto" />  <!-- 8 tasks -->
        <RowDefinition Height="Auto" />  <!-- 9 empty / no matches -->
        <RowDefinition Height="Auto" />  <!-- 10 coming up -->
        <RowDefinition Height="Auto" />  <!-- 11 quick add -->
        <RowDefinition Height="Auto" />  <!-- 12 status + undo -->
        <RowDefinition Height="Auto" />  <!-- 13 key hints -->
      </Grid.RowDefinitions>

      <!-- 0 Greeting, date, weather, progress, buttons -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Greeting}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     FontFamily="Segoe UI Variable Display, Segoe UI" />
          <WrapPanel Margin="0,2,0,0">
            <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding ShowWeather, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding WeatherGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource Greeter.AccentBrush}" Margin="0,1,5,0" />
              <TextBlock Text="{Binding WeatherLine}" FontSize="13" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,-6,-12,0">
          <Grid Width="40" Height="40" Margin="0,2,6,0" ToolTip="{Binding ProgressToolTip}"
                Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}">
            <local:ProgressRing Value="{Binding ProgressFraction}" Thickness="4"
                                Brush="{DynamicResource Greeter.SuccessBrush}" TrackBrush="{DynamicResource Greeter.ChipBrush}" />
            <TextBlock Text="{Binding ProgressLabel}" FontSize="10" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <Button Style="{StaticResource GhostButton}" ToolTip="Search all tasks (Ctrl+F)" Command="{Binding ToggleSearchCommand}"
                  Visibility="{Binding IsConnected, Converter={StaticResource Vis}}" VerticalAlignment="Top">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
          <Button Style="{StaticResource GhostButton}" ToolTip="Refresh (F5)" Command="{Binding RetryCommand}"
                  Visibility="{Binding IsConnected, Converter={StaticResource Vis}}" VerticalAlignment="Top">
            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
          <Button Style="{StaticResource GhostButton}" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Top">
            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
          <Button Style="{StaticResource GhostButton}" ToolTip="Close (Esc)" Click="OnCloseClick" VerticalAlignment="Top">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 1 Quote of the day -->
      <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding ShowQuote, Converter={StaticResource Vis}}">
        <Run Text="{Binding QuoteText, Mode=OneWay}" FontStyle="Italic" />
        <Run Text="{Binding QuoteAuthor, Mode=OneWay}" />
      </TextBlock>

      <!-- 2 Summary -->
      <Border Grid.Row="2" Margin="0,12,0,4" Padding="12,8" CornerRadius="8" Background="{DynamicResource Greeter.PanelBrush}">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource Greeter.AccentBrush}" />
          <TextBlock Text="{Binding Summary}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- 3 Plan your day / Wrap up -->
      <Border Grid.Row="3" Margin="0,6,0,2" Padding="12,9" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource Greeter.AccentBrush}"
              Visibility="{Binding ShowDayPrompt, Converter={StaticResource Vis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="{Binding DayPromptGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18"
                     Foreground="{DynamicResource Greeter.AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Not now" Command="{Binding DismissDayPromptCommand}"
                  VerticalAlignment="Center" Margin="4,0,-6,0">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
          </Button>
          <Button DockPanel.Dock="Right" Content="{Binding DayPromptButton}" Command="{Binding DayPromptCommand}" Padding="10,4"
                  VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"
                  Visibility="{Binding DayPromptButton, Converter={StaticResource Vis}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DayPromptTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DayPromptText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 4 TaskHub not running / not responding -->
      <Border Grid.Row="4" Margin="0,8,0,4" Padding="14,12" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource Greeter.WarningBrush}"
              Visibility="{Binding ShowOffline, Converter={StaticResource Vis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="20"
                     Foreground="{DynamicResource Greeter.WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Start TaskHub" Command="{Binding StartTaskHubCommand}" Padding="12,5" Margin="8,0,0,0"
                    Visibility="{Binding CanStartTaskHub, Converter={StaticResource Vis}}" />
            <Button Content="Retry" Command="{Binding RetryCommand}" Padding="12,5" Margin="8,0,0,0" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ConnectionMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Your tasks will show here once it's up." FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 5 Search -->
      <Grid Grid.Row="5" Margin="0,8,0,0" Visibility="{Binding IsSearchOpen, Converter={StaticResource Vis}}">
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                 Padding="34,6,10,6" PreviewKeyDown="OnSearchKeyDown" />
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                   Margin="12,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="Search all open tasks…" FontSize="13" VerticalAlignment="Center" Margin="36,0,10,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding SearchText, Converter={StaticResource Vis}, ConverterParameter=invert}" />
      </Grid>

      <!-- 6 Filter chips -->
      <ItemsControl Grid.Row="6" Margin="0,10,0,0" ItemsSource="{Binding Chips}" Focusable="False"
                    Visibility="{Binding ShowChips, Converter={StaticResource Vis}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:FilterChip}">
            <Button Style="{StaticResource FilterChipButton}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.SelectChipCommand, RelativeSource={RelativeSource AncestorType=Window}}">
              <TextBlock Text="{Binding Label}" FontSize="12" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 7 Meetings -->
      <StackPanel Grid.Row="7" Visibility="{Binding ShowMeetings, Converter={StaticResource Vis}}">
        <TextBlock Text="Meetings" Style="{StaticResource SectionHeader}" />
        <ItemsControl ItemsSource="{Binding Meetings}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:MeetingRow}">
              <Grid x:Name="MeetingGrid" Margin="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MeetingTime" Text="{Binding TimeLabel}" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" FontSize="13">
                  <Run x:Name="MeetingTitle" Text="{Binding Title, Mode=OneWay}" />
                  <Run Text="{Binding Location, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                  <Setter TargetName="MeetingGrid" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNow}" Value="True">
                  <Setter TargetName="MeetingTime" Property="Foreground" Value="{DynamicResource Greeter.AccentBrush}" />
                  <Setter TargetName="MeetingTime" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- 8 Tasks (today, or search results) -->
      <ListBox x:Name="TaskList" Grid.Row="8" Margin="-6,6,-6,0" MaxHeight="380"
               ItemsSource="{Binding ActiveView}" SelectedItem="{Binding SelectedRow}"
               BorderThickness="0" Background="Transparent"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizingWhenGrouping="False"
               KeyboardNavigation.DirectionalNavigation="Contained"
               PreviewKeyDown="OnListKeyDown" PreviewTextInput="OnListTextInput"
               Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock x:Name="Header" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                           Margin="10,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Name}" Value="Overdue">
                    <Setter TargetName="Header" Property="Foreground" Value="{DynamicResource Greeter.OverdueBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>

        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
          </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:TaskRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Focusable="False"
                        VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" Padding="0"
                        IsEnabled="{Binding IsBusy, Converter={x:Static local:Inverse.Instance}}"
                        ToolTip="Complete (Space)" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <StackPanel.Visibility>
                    <MultiBinding Converter="{x:Static local:AnyVisible.Instance}">
                      <Binding Path="HasTags" />
                      <Binding Path="IsRecurring" />
                      <Binding Path="DoneNote" />
                    </MultiBinding>
                  </StackPanel.Visibility>
                  <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,1,6,0"
                             VerticalAlignment="Center" ToolTip="{Binding RecurrenceText}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             Visibility="{Binding IsRecurring, Converter={StaticResource Vis}}" />
                  <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Chip}">
                          <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="#" /><Run Text="{Binding Mode=OneWay}" />
                          </TextBlock>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding DoneNote}" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Greeter.SuccessBrush}"
                             Visibility="{Binding DoneNote, Converter={StaticResource Vis}}" />
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="PriorityText" Grid.Column="2" Text="{Binding PriorityMarker}" FontWeight="Bold" FontSize="13"
                         VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Greeter.AccentBrush}"
                         ToolTip="Priority" />
              <TextBlock x:Name="DueText" Grid.Column="3" Text="{Binding DueLabel}" FontSize="13" VerticalAlignment="Center"
                         Margin="12,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource Greeter.OverdueBrush}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Greeter.OverdueBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding PriorityRank}" Value="4">
                <Setter TargetName="PriorityText" Property="Foreground" Value="{DynamicResource Greeter.OverdueBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="TitleText" Property="Opacity" Value="0.55" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter TargetName="DueText" Property="Opacity" Value="0.55" />
                <Setter TargetName="PriorityText" Property="Opacity" Value="0.4" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 9 Nothing today / no search matches -->
      <StackPanel Grid.Row="9" Margin="0,18,0,12" HorizontalAlignment="Center"
                  Visibility="{Binding ShowEmpty, Converter={StaticResource Vis}}">
        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center"
                   Foreground="{DynamicResource Greeter.SuccessBrush}" />
        <TextBlock Text="Nothing due today. Enjoy it!" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <TextBlock Grid.Row="9" Margin="4,12,0,8" Text="No matching open tasks." FontSize="13"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding ShowNoMatches, Converter={StaticResource Vis}}" />

      <!-- 10 Coming up -->
      <Expander Grid.Row="10" Margin="0,8,0,0" IsExpanded="{Binding IsUpcomingExpanded, Mode=TwoWay}" Focusable="False"
                Visibility="{Binding ShowUpcoming, Converter={StaticResource Vis}}">
        <Expander.Header>
          <TextBlock Text="{Binding UpcomingHeader}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Expander.Header>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Focusable="False">
          <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False" Margin="4,0,0,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:UpcomingGroup}">
                <StackPanel Margin="0,4,0,2">
                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:UpcomingItem}">
                        <Grid Margin="8,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding PriorityMarker}" FontSize="12" FontWeight="Bold" Margin="8,0,0,0"
                                     Foreground="{DynamicResource Greeter.AccentBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>

      <!-- 11 Quick add -->
      <Grid Grid.Row="11" Margin="0,10,0,0" Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
        <TextBox x:Name="QuickAdd" Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                 Padding="34,7,10,7" PreviewKeyDown="OnQuickAddKeyDown" TextChanged="OnQuickAddChanged"
                 IsReadOnly="{Binding IsAdding}"
                 ToolTip="TaskHub quick-add syntax: dates, times, #tags, !priority, @list" />
        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                   Margin="12,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Placeholder" Text="Add a task — e.g. Pay rent tomorrow 9am #home !high @Finance"
                   FontSize="13" VerticalAlignment="Center" Margin="36,0,10,0" IsHitTestVisible="False"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.8" />
      </Grid>

      <!-- 12 Status + Undo -->
      <DockPanel Grid.Row="12" Margin="0,8,0,0" LastChildFill="True">
        <Button DockPanel.Dock="Right" Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" Padding="10,3"
                Focusable="False" Visibility="{Binding CanUndo, Converter={StaticResource Vis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Undo" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="2,0,8,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource Greeter.OverdueBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>

      <TextBlock Grid.Row="13" Margin="2,8,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                 Text="↑↓ move · Space done · Ctrl+T tomorrow · Ctrl+Shift+T next week · Ctrl+D today · Ctrl+S snooze · Ctrl+F search · Ctrl+Z undo · right-click for more · Esc close" />
    </Grid>
  </Border>
</Window>
